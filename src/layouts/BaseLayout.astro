---
import { ClientRouter } from "astro:transitions";
import MarkdownAlternate from "../integrations/agent-markdown/MarkdownAlternate.astro";

import "../styles/fonts.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import ServicesHeader from "../components/ServicesHeader.astro";
import Footer from "../components/Footer.astro";
import MobileStickyCTA from "../components/MobileStickyCTA.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import ClickBurst from "../components/ClickBurst.astro";
import Schema from "../components/SEO/Schema.astro";
import type { BrandConfig } from "../brands";
import { mobileTiresBrand } from "../brands";

const {
  title = "Queens Mobile Tires",
  description = "We come to you.",
  brand: propBrand,
  headerInverse = false,
  serviceData,
  faqData,
  reviewData,
  forceDarkTheme = false,
  forceDarkHeader = false,
} = Astro.props;

// Use provided brand or default to mobile tires brand
const brand: BrandConfig = propBrand || mobileTiresBrand;

const currentPath = Astro.url.pathname;
// Pages excluded from markdown twins in astro.config.mjs (agentMarkdown exclude).
const hasMarkdownTwin = !/^\/(404|coming-soon|customer-details|schedule-|thank-you|tireflow-test)/.test(currentPath);
const pathSegments = currentPath.split("/").filter(Boolean);

// Archive is just /services (1 segment)
const isServicesArchive =
  pathSegments.length === 1 && pathSegments[0] === "services";
// Category is /services/category (2 segments)
const isCategoryPage =
  pathSegments.length === 2 && pathSegments[0] === "services";
// Sub-page (individual service) is /services/category/service (3 segments)
const isServiceSubPage =
  pathSegments.length === 3 && pathSegments[0] === "services";

// Force regular header for archive and categories since they use standard bg-page
const useServicesHeader =
  (isServiceSubPage || forceDarkHeader) &&
  !isCategoryPage &&
  !isServicesArchive;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Google Tag Manager (deferred)
         The dataLayer and gtm.start timestamp are set right away so no events
         are lost; the GTM script itself (and GA4, Ads, Meta, Clarity, which it
         loads) is fetched on the visitor's first tap / wheel / keypress, or
         GTM_DELAY_MS after the load event, whichever comes first, so it
         doesn't compete with the first paint. -->
    <script is:inline>
      (function (w, d, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var loaded = false;
        var GTM_DELAY_MS = 4000;
        // Real input only: "scroll" also fires on programmatic scrolls.
        var events = ["pointerdown", "keydown", "touchstart", "wheel"];
        function loadGTM() {
          if (loaded) return;
          loaded = true;
          events.forEach(function (e) {
            w.removeEventListener(e, loadGTM);
          });
          // Served first-party through the Cloudflare Google tag gateway at
          // /77f3/ (better ad measurement); fall back to Google if it fails.
          w.google_tags_first_party = w.google_tags_first_party || [];
          w.google_tags_first_party.push(i);
          var j = d.createElement("script");
          j.async = true;
          j.src = "/77f3/";
          j.onerror = function () {
            var f = d.createElement("script");
            f.async = true;
            f.src = "https://www.googletagmanager.com/gtm.js?id=" + i;
            d.head.appendChild(f);
          };
          d.head.appendChild(j);
        }
        events.forEach(function (e) {
          w.addEventListener(e, loadGTM, { once: true, passive: true });
        });
        function afterLoad() {
          setTimeout(loadGTM, GTM_DELAY_MS);
        }
        if (d.readyState === "complete") afterLoad();
        else w.addEventListener("load", afterLoad, { once: true });
      })(window, document, "dataLayer", "GTM-NJBHC4TP");
    </script>
    <!-- End Google Tag Manager -->

    <!-- Critical Font Preloads - Load these before CSS parsing -->
    <link
      rel="preload"
      href="/fonts/BigShoulders-Display-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/InstrumentSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <Schema
      brand={brand}
      title={title}
      description={description}
      serviceData={serviceData}
      faqData={faqData}
      reviewData={reviewData}
    />
    <ClientRouter />
    {hasMarkdownTwin && <MarkdownAlternate />}
    <script is:inline define:vars={{ forceDarkTheme }}>
      const applyTheme = () => {
        if (forceDarkTheme) {
          document.documentElement.classList.add("dark");
          document.documentElement.setAttribute("data-theme", "dark");
          return;
        }

        if (
          localStorage.getItem("color-theme") === "dark" ||
          (!("color-theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      // Apply on initial load
      applyTheme();

      // Re-apply after View Transitions swap
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <!-- Always start fresh from top on page load -->
    <script is:inline>
      // Disable browser's automatic scroll restoration - always start at top
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      // Scroll to top immediately
      window.scrollTo(0, 0);

      // Force a full page load (no view-transition swap) for /buy-new-tires
      // and the always-dark landing pages. A swap would run this layout's
      // theme script on the landing page and strip its `dark` class in light
      // mode, leaving grey text on the navy background.
      const FULL_RELOAD = /^\/(buy-new-tires|brakes|wheel-alignment|auto-repair-discount)\/?$/;
      document.addEventListener("astro:before-preparation", (ev) => {
        if (FULL_RELOAD.test(ev.to.pathname)) {
          ev.preventDefault();
          window.location.href = ev.to.href;
        }
      });

      // GTM / View Transitions Compatibility
      // This tells GTM that a "page view" happened even when Astro swaps content
      document.addEventListener(
        "astro:page-load",
        () => {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "page_view",
            page_path: window.location.pathname,
            page_title: document.title,
          });

          // Phone Click Tracking
          // This captures any click on a "tel:" link and sends it to GTM
          document.querySelectorAll('a[href^="tel:"]').forEach((link) => {
            link.addEventListener("click", () => {
              window.dataLayer.push({
                event: "phone_click",
                phone_number: link.getAttribute("href").replace("tel:", ""),
                click_location: document.title,
              });
            });
          });

          // Banner Click Tracking
          // This captures any click on an element with data-banner-name and sends it to GTM
          document.querySelectorAll("[data-banner-name]").forEach((banner) => {
            banner.addEventListener("click", () => {
              window.dataLayer.push({
                event: "banner_click",
                banner_name: banner.getAttribute("data-banner-name"),
                banner_url: banner.getAttribute("href"),
                click_location: document.title,
              });
            });
          });
        },
        { once: false },
      );
    </script>
    <slot name="head" />
  </head>
  <body
    class="bg-page text-queens-primary flex flex-col min-h-screen w-full overflow-x-hidden dark:text-gray-100"
    class:list={[{ "theme-locked-bg": forceDarkTheme }]}
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NJBHC4TP"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main-content" class="skip-to-content-link">Skip to main content</a
    >

    {
      useServicesHeader ? (
        <ServicesHeader
          brand={brand}
          inverse={headerInverse || forceDarkHeader}
        />
      ) : (
        <Header brand={brand} inverse={headerInverse} />
      )
    }

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer brand={brand} />
    <SmoothScroll />
    <ClickBurst />
    {/* <MobileStickyCTA brand={brand} /> */}

    <!-- Lazy videos: <video data-lazy-video data-poster> with <source data-src>.
         The poster image is attached once the video is near the viewport, and
         the MP4 itself only after the page has finished loading AND the video
         is near the viewport, so neither competes with the first paint. -->
    <script is:inline>
      (function () {
        var pageLoaded = document.readyState === "complete";
        var io = null;
        var posterIo = null;

        function setPoster(video) {
          var p = video.getAttribute("data-poster");
          if (p) {
            video.removeAttribute("data-poster");
            video.poster = p;
          }
        }

        function initLazyPosters() {
          var videos = document.querySelectorAll("video[data-poster]");
          if (!videos.length) return;
          if (!("IntersectionObserver" in window)) {
            videos.forEach(setPoster);
            return;
          }
          if (posterIo) posterIo.disconnect();
          posterIo = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  posterIo.unobserve(entry.target);
                  setPoster(entry.target);
                }
              });
            },
            { rootMargin: "300px 0px" },
          );
          videos.forEach(function (v) {
            posterIo.observe(v);
          });
        }

        function loadVideo(video) {
          if (video.hasAttribute("data-lazy-loaded")) return;
          video.setAttribute("data-lazy-loaded", "");
          setPoster(video);
          video.querySelectorAll("source[data-src]").forEach(function (s) {
            s.src = s.getAttribute("data-src");
          });
          video.load();
          if (video.muted) video.play().catch(function () {});
        }

        function initLazyVideos() {
          if (!pageLoaded) return;
          var videos = document.querySelectorAll(
            "video[data-lazy-video]:not([data-lazy-loaded])",
          );
          if (!videos.length) return;
          if (!("IntersectionObserver" in window)) {
            videos.forEach(loadVideo);
            return;
          }
          if (io) io.disconnect();
          io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  io.unobserve(entry.target);
                  loadVideo(entry.target);
                }
              });
            },
            { rootMargin: "400px 0px" },
          );
          videos.forEach(function (v) {
            io.observe(v);
          });
        }

        if (!pageLoaded) {
          window.addEventListener(
            "load",
            function () {
              pageLoaded = true;
              initLazyVideos();
            },
            { once: true },
          );
        }
        initLazyPosters();
        document.addEventListener("astro:page-load", function () {
          initLazyPosters();
          initLazyVideos();
        });
      })();
    </script>

    <!-- Global video autoplay fallback for Edge/browser compatibility -->
    <script is:inline>
      function forceAllVideosToPlay() {
        document.querySelectorAll("video").forEach(function (video) {
          if (video.paused && video.muted) {
            video.play().catch(function () {
              // Silent fail - browser policy blocks autoplay
            });
          }
        });
      }

      // Run on initial load
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", forceAllVideosToPlay);
      } else {
        forceAllVideosToPlay();
      }

      // Run after Astro view transitions
      document.addEventListener("astro:page-load", forceAllVideosToPlay);

      // Also run after a short delay in case videos load late
      setTimeout(forceAllVideosToPlay, 500);
    </script>
  </body>
</html>
