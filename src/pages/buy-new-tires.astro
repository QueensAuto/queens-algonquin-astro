---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaButton from "../components/CtaButton.astro";

const shopFront = "/images/buy-new-tires/queens-auto-service-algonquin-tire-shop-front.webp";
const shopExterior = "/images/buy-new-tires/queens-auto-service-algonquin-tire-shop-exterior.webp";
const techAtWork = "/images/buy-new-tires/mechanic-changing-bus-tire-queens-auto-mobile-service.webp";
const gallery = [
  { src: "/images/buy-new-tires/new-ironman-tires-on-racks-queens-auto-algonquin.webp", alt: "New Ironman tires stocked on racks at Queens Auto" },
  { src: "/images/buy-new-tires/queens-auto-algonquin-cooper-tires-display-vertical.webp", alt: "Cooper tires on display at Queens Auto" },
  { src: "/images/buy-new-tires/queens-auto-algonquin-tires-displayed-outside-shop.webp", alt: "Tires displayed outside the Queens Auto shop" },
  { src: "/images/buy-new-tires/tire-inventory-display-racks-queens-auto-service.webp", alt: "Tire inventory on display racks at Queens Auto" }
];
---

<BaseLayout title="Buy New Tires | Queens Auto Services">
  <!-- Hero Section -->
  <section
    class="tire-hero pt-32 pb-16 md:pt-40 md:pb-20 lg:pb-24 overflow-hidden"
  >
    <div class="site-canvas">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Left: Content -->
        <div class="hero-content">
          <h1
            class="display-hero-page text-queens-primary dark:text-white mb-6"
          >
            Find Great <span class="text-queens-secondary">Deals On Tires</span
            >.<br />
            Shop Local!
          </h1>
          <p
            class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-lg leading-relaxed"
          >
            Get new tires from the brands you trust, installed by an
            <strong>experienced tire shop</strong> that's been serving Algonquin
            since 2007. Call us and we'll find the perfect tires for your
            vehicle and budget.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <CtaButton
              href="tel:+18478441700"
              text="Call (847) 844-1700"
            />
            <a
              href="/request-an-appointment"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-full border-2 border-gray-200 dark:border-white/20 text-gray-700 dark:text-gray-200 font-bold uppercase tracking-widest text-sm hover:border-queens-primary hover:text-queens-primary transition-all duration-300"
            >
              Book Online
            </a>
          </div>
          <div
            class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-8 text-sm text-gray-500 dark:text-gray-400"
          >
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4 text-queens-primary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
              </svg>
              Expert installation included
            </span>
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4 text-queens-primary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
              </svg>
              All major brands
            </span>
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4 text-queens-primary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
              </svg>
              Honest out-the-door pricing
            </span>
          </div>
        </div>

        <!-- Right: Shop image + experience badge -->
        <div class="relative">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img
              src={shopFront}
              alt="The Queens Auto Service tire shop front in Algonquin"
              class="w-full h-full object-cover aspect-[4/3]"
              loading="eager"
            />
          </div>
          <div
            class="absolute bottom-4 left-4 bg-white/95 dark:bg-gray-900/90 backdrop-blur rounded-2xl px-5 py-4 shadow-xl"
          >
            <div class="flex items-center gap-1.5 mb-1">
              <svg class="w-4 h-4 text-queens-primary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-[0.65rem] uppercase font-bold tracking-wider text-gray-500 dark:text-gray-400">Since 2007</span>
            </div>
            <p class="font-display font-black text-gray-900 dark:text-white text-lg leading-tight">
              Experienced Tire Shop
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              25,000+ sets installed in Algonquin
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why buy local: trust section -->
  <section
    id="why-local"
    class="py-16 md:py-24"
    data-reveal
  >
    <div class="site-canvas">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span
            class="font-serif italic text-queens-primary text-xl"
            data-reveal-item
          >
            Why buy from us?
          </span>
          <h2
            class="display-md text-queens-primary dark:text-white mt-2 mb-6"
            data-reveal-item
          >
            The Big Box Stores
            <span class="text-queens-secondary">Won't Tell You This</span>
          </h2>
          <p
            class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-8"
            data-reveal-item
          >
            Ordering online leaves you with tires in your garage and no one to
            answer for the install. Big box stores upsell you at the counter.
            We do it differently: fair pricing up front, Hunter precision
            equipment, and a team that's been mounting tires on Algonquin
            roads for nearly two decades.
          </p>

          <div
            class="grid sm:grid-cols-2 gap-5"
            data-reveal-item
          >
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-queens-primary/10 text-queens-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="benefit-title font-bold text-gray-900 dark:text-white mb-1">No Counter Upsells</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">The quote we give you is the price you pay. Out the door.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-queens-primary/10 text-queens-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="benefit-title font-bold text-gray-900 dark:text-white mb-1">Hunter Precision Install</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">Touchless mounting and road-force balancing on pro equipment.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-queens-primary/10 text-queens-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="benefit-title font-bold text-gray-900 dark:text-white mb-1">Same-Day Service</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">Most sets are installed the same day you call.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-queens-primary/10 text-queens-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="benefit-title font-bold text-gray-900 dark:text-white mb-1">Neighbors, Not a Chain</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">25,000+ local drivers served from our shop on E Algonquin Rd.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Trust panel -->
        <div class="relative rounded-3xl bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 shadow-xl overflow-hidden" data-reveal-item>
          <img
            src={techAtWork}
            alt="A Queens Auto team member mounting a tire at the shop"
            class="w-full h-44 object-cover"
            loading="lazy"
          />
          <div class="p-8 md:p-10">
            <h3 class="font-display font-black text-xl uppercase tracking-tight text-gray-900 dark:text-white mb-6">
              Shop The Brands You Trust
            </h3>
            <div class="grid grid-cols-2 gap-3 mb-8">
              {
                ["Michelin", "Goodyear", "Bridgestone", "Continental", "Pirelli", "BFGoodrich"].map((brand) => (
                  <div class="flex items-center gap-2.5 px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/10">
                    <svg class="w-4 h-4 text-queens-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="font-bold text-sm text-gray-700 dark:text-gray-200">{brand}</span>
                  </div>
                ))
              }
            </div>

            <div class="rounded-2xl bg-gradient-to-br from-queens-primary/10 to-queens-secondary/10 border border-queens-primary/20 p-6">
              <div class="flex items-center gap-3 mb-2">
                <div class="flex text-queens-secondary" aria-hidden="true">
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"></path>
                    </svg>
                  ))}
                </div>
                <span class="font-black text-gray-900 dark:text-white">4.5 / 5</span>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                Average rating from 1,000+ happy customers across Algonquin,
                Carpentersville, Lake in the Hills, and beyond.
              </p>
              <a
                href="/request-an-appointment"
                class="inline-flex items-center gap-2 font-bold text-sm uppercase tracking-widest text-queens-primary hover:gap-3 transition-all"
              >
                Get On The Schedule
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Shop & inventory gallery -->
  <section class="py-16 md:py-24" data-reveal>
    <div class="site-canvas">
      <div class="text-center mb-12" data-reveal-item>
        <span class="font-serif italic text-queens-primary text-xl">
          — Inside the shop
        </span>
        <h2 class="display-md text-queens-primary dark:text-white mb-3 mt-2">
          A Real Tire Shop, With Real Stock
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-lg max-w-2xl mx-auto">
          Walk in and see the inventory for yourself. New sets on the racks,
          popular sizes in stock, and a team that's been doing this for years.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {gallery.map((img) => (
          <div
            class="relative rounded-2xl overflow-hidden aspect-[4/3] group"
            data-reveal-item
          >
            <img
              src={img.src}
              alt={img.alt}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="process-section py-16 md:py-24 bg-gray-50 dark:bg-white/[0.03]" data-reveal>
    <div class="site-canvas">
      <div class="text-center mb-14" data-reveal-item>
        <span class="font-serif italic text-queens-primary text-xl">
          — How it works
        </span>
        <h2 class="display-md text-queens-primary dark:text-white mb-3 mt-2">
          Finding Great Tire Deals
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-lg">
          Has Never Been Easier
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
      >
        <!-- Step 1 -->
        <div class="process-card" data-reveal-item>
          <div
            class="process-icon bg-queens-secondary/10 text-queens-secondary"
          >
            <svg
              class="w-7 h-7"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
              ></path>
            </svg>
          </div>
          <h3 class="process-title">Call The Shop</h3>
          <p class="process-desc">
            Give us a ring or stop by — we'll talk through your vehicle,
            driving needs, and budget.
          </p>
          <span class="process-step" aria-hidden="true">01</span>
        </div>

        <!-- Step 2 -->
        <div class="process-card" data-reveal-item>
          <div
            class="process-icon bg-queens-secondary/10 text-queens-secondary"
          >
            <svg
              class="w-7 h-7"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              ></path>
            </svg>
          </div>
          <h3 class="process-title">Find The Right Tires</h3>
          <p class="process-desc">
            We match you with the best options for your vehicle and give you
            an out-the-door price.
          </p>
          <span class="process-step" aria-hidden="true">02</span>
        </div>

        <!-- Step 3 -->
        <div class="process-card" data-reveal-item>
          <div
            class="process-icon bg-queens-secondary/10 text-queens-secondary"
          >
            <svg
              class="w-7 h-7"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"
              ></path>
            </svg>
          </div>
          <h3 class="process-title">Order Your Tires</h3>
          <p class="process-desc">
            Pick your set and lock in your price — we handle the ordering for
            you.
          </p>
          <span class="process-step" aria-hidden="true">03</span>
        </div>

        <!-- Step 4 -->
        <div class="process-card" data-reveal-item>
          <div
            class="process-icon bg-queens-secondary/10 text-queens-secondary"
          >
            <svg
              class="w-7 h-7"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"
              ></path>
            </svg>
          </div>
          <h3 class="process-title">Installed At Queens</h3>
          <p class="process-desc">
            Mounted, balanced, and aligned the right way by our experienced
            tire team in Algonquin.
          </p>
          <span class="process-step" aria-hidden="true">04</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta py-16 md:py-24" data-reveal>
    <div class="site-canvas">
      <div
        class="relative overflow-hidden rounded-3xl text-white shadow-2xl"
        data-reveal-item
      >
        <!-- Photo background with blue overlay -->
        <img
          src={shopExterior}
          alt=""
          class="absolute inset-0 w-full h-full object-cover"
          aria-hidden="true"
          loading="lazy"
        />
        <div class="cta-overlay absolute inset-0"></div>

        <div class="relative px-8 py-12 md:px-16 md:py-16 text-center">
          <span class="font-serif italic text-white/90 text-xl">
            Ready when you are
          </span>
          <h2 class="display-md mt-2 mb-4">
            Ready For New Tires? One Call Does It.
          </h2>
          <p class="cta-sub text-lg text-white/85 max-w-xl mx-auto leading-relaxed mb-8">
            Tell us your vehicle or tire size and we'll match you with the
            right tires — at a fair out-the-door price, with expert
            installation included.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="tel:+18478441700"
              data-banner-name="Get Tire Prices Final CTA"
              class="cta-call inline-flex items-center gap-3 px-9 py-4 rounded-full font-black uppercase tracking-widest text-sm shadow-xl hover:shadow-2xl hover:scale-[1.03] transition-all duration-300"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"></path>
              </svg>
              Call (847) 844-1700
            </a>
            <a
              href="/request-an-appointment"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-full border-2 border-white/60 text-white font-bold uppercase tracking-widest text-sm hover:bg-white/10 hover:border-white transition-all duration-300"
            >
              Or Book Online
            </a>
          </div>

          <p class="cta-note text-sm text-white/70 mt-6">
            Fast quotes. Honest pricing. Installed at 2401 E Algonquin Rd,
            Algonquin — Mon–Fri 7:30–6, Sat 7:30–4.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tire-hero {
    background: var(--bg-page);
  }

  .process-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.5rem 1.5rem;
