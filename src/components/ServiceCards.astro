---
const services = [
  {
    title: "Price Per Axle",
    subtitle: "$369 BRAKE SPECIAL",
    description: "Professional brake pad and rotor inspection with complete brake service. Includes quality parts, labor, and a comprehensive safety check.",
    image: "/images/services/Changing brakes.webp",
    alt: "Professional Brake System Service",
    link: "https://brakes.queensautoservices.com/",
    trackingClass: "brake-banner-link"
  },
  {
    title: "Limited Time Offer",
    subtitle: "$35 OFF ALIGNMENT",
    description: "Precision 4-wheel alignment using state-of-the-art equipment. Extend tire life and improve fuel efficiency with proper alignment.",
    image: "/images/services/Wheel-Alignment-Algonquin-001.webp",
    alt: "Wheel Alignment Special Offer",
    link: "https://wheel-alignment.queensautoservices.com/",
    trackingClass: "alignment-banner-link"
  },
  {
    title: "General Repair",
    subtitle: "$100 OFF SERVICES",
    description: "Save on engine diagnostics, transmission work, electrical repairs, and more. First-time customers get an extra discount!",
    image: "/images/services/Queens-Auto-Services-Auto-Repair-Slider-007.webp",
    alt: "General Repair Discount",
    link: "https://offer.queensautoservices.com/",
    trackingClass: "auto-repair-banner-link"
  }
];

const slideCount = services.length;
---

<section id="homepage-deals" class="deals-section">
  <div class="deals-pin-wrapper">
    <div class="deals-container site-canvas">
      <!-- Section header so visitors instantly know what this is -->
      <div class="deals-header">
        <span class="deals-eyebrow">Current Offers</span>
        <h2 class="deals-heading">
          Deals happening <span class="deals-heading-accent">right now</span>
        </h2>
      </div>

      <!-- Sticky Number Column (Left) -->
      <div class="deals-number-column">
        <!-- Progress Bar -->
        <div class="deals-progress-bar">
          <div class="deals-progress-fill" id="deals-progress-fill"></div>
        </div>
        <span class="deals-number" id="deals-active-number">01</span>
      </div>

      <!-- Slides Container (Right) -->
      <div class="deals-slides-viewport">
        <div class="deals-slides-track">
          {services.map((service, index) => (
            <div
              class={`deals-slide ${index === 0 ? 'active' : ''}`}
              data-index={index}
              role="group"
              aria-roledescription="slide"
              aria-label={`Offer ${index + 1} of ${slideCount}`}
            >
              <!-- Text Content -->
              <div class="deals-slide-content">
                <span class="deals-slide-eyebrow">
                  {service.title}
                </span>
                <h3 class="deals-slide-title">
                  {service.subtitle}
                </h3>
                <p class="deals-slide-description">
                  {service.description}
                </p>
                <a
                  href={service.link}
                  class={`deals-slide-cta ${service.trackingClass}`}
                  data-banner-name={service.subtitle}
                >
                  <span>Claim Offer</span>
                  <svg class="cta-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </a>
              </div>

              <!-- Image -->
              <div class="deals-slide-image-wrapper">
                <img
                  src={service.image}
                  alt={service.alt}
                  class="deals-slide-image"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Controls: dots + arrows + counter + scroll hint -->
      <div class="deals-controls">
        <button
          type="button"
          class="deals-nav-btn"
          id="deals-prev"
          aria-label="Previous offer"
        >
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <div class="deals-dots" role="group" aria-label="Offer navigation">
          {services.map((_, index) => (
            <button
              type="button"
              class={`deals-dot ${index === 0 ? 'active' : ''}`}
              data-dot-index={index}
              aria-label={`Go to offer ${index + 1} of ${slideCount}`}
              aria-current={index === 0 ? 'true' : undefined}
            ></button>
          ))}
        </div>

        <button
          type="button"
          class="deals-nav-btn"
          id="deals-next"
          aria-label="Next offer"
        >
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <span class="deals-counter" aria-hidden="true">
          <span id="deals-counter-current">01</span>&nbsp;/&nbsp;{String(slideCount).padStart(2, '0')}
        </span>

        <span class="deals-scroll-hint" id="deals-scroll-hint" aria-hidden="true">
          Scroll for more
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7-7-7m7 7V3"></path>
          </svg>
        </span>
      </div>
    </div>
  </div>

  <!-- Screen-reader announcement of slide changes -->
  <div class="deals-sr-only" aria-live="polite" id="deals-live-region"></div>
</section>

<style>
  .deals-section {
    position: relative;
    background-color: var(--color-page);
    z-index: 20;
  }

  .deals-pin-wrapper {
    min-height: 100vh;
    background-color: var(--color-page);
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
  }

  .deals-container {
    display: grid;
    grid-template-columns: min-content 1fr; /* Allow number to dictate width */
    grid-template-rows: auto 1fr auto;
    gap: 2.5rem 4rem;
    width: 100%; /* .deals-pin-wrapper is a flex container; stretch like a block would */
    min-height: 100vh;
    align-items: center;
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  /* Section header */
  .deals-header {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-self: end;
  }

  .deals-eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--queens-primary);
  }

  .deals-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: #0f172a;
    line-height: 1.05;
    margin: 0;
  }

  :global(.dark) .deals-heading {
    color: #f8fafc;
  }

  .deals-heading-accent {
    color: var(--queens-primary);
  }

  @media (max-width: 1023px) {
    .deals-container {
      grid-template-columns: 80px 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .deals-container {
      grid-template-columns: 1fr;
      padding-top: 1.5rem;
      gap: 1rem;
      min-height: 100svh;
    }

    /* On mobile, keep it in flow but compact */
    .deals-number-column {
      position: relative;
      top: auto;
      left: auto;
      margin-bottom: -0.5rem; /* Tighten up spacing to content */
      z-index: 10;
    }

    .deals-heading {
      font-size: 1.75rem;
    }
  }

  /* Number Column */
  .deals-number-column {
    display: flex;
    flex-direction: row; /* Side by side */
    align-items: center; /* Center vertically */
    gap: 1.5rem;
    position: relative;
    z-index: 50; /* Ensure it stays above slides */
  }

  .deals-number {
    font-family: var(--font-display);
    /* Significantly reduced size */
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 900;
    line-height: 0.85;
    color: #0f172a;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.dark) .deals-number {
    color: #f8fafc;
  }

  /* Progress Bar */
  .deals-progress-bar {
    width: 4px;
    height: 80px;
    background-color: rgba(203, 213, 225, 0.4);
    border-radius: 2px;
    margin-left: 0; /* Removed margin */
    position: relative;
    overflow: hidden;
    flex-shrink: 0; /* Prevent collapsing on desktop */
  }

  :global(.dark) .deals-progress-bar {
    background-color: rgba(71, 85, 105, 0.5);
  }

  .deals-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background-color: var(--queens-primary);
    border-radius: 2px;
    transition: height 0.1s ease-out;
  }

  /* Slides Viewport */
  .deals-slides-viewport {
    position: relative;
    overflow: hidden;
  }

  .deals-slides-track {
    position: relative;
    min-height: min(58vh, 560px);
  }

  /* Individual Slide - CSS-powered smooth transitions */
  .deals-slide {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 1;
    transition:
      opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: opacity;
  }

  .deals-slide.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 5;
  }

  @media (max-width: 1023px) {
    .deals-slide {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .deals-slides-track {
      min-height: 440px;
    }
  }

  /* Slide Content - staggered CSS animations */
  .deals-slide-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .deals-slide-eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--queens-primary);
    line-height: 1.2;
    opacity: 0;
    transform: translateY(15px);
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.1s,
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.1s;
  }

  .deals-slide.active .deals-slide-eyebrow {
    opacity: 1;
    transform: translateY(0);
  }

  .deals-slide-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    color: #0f172a;
    line-height: 1;
    margin: 0.5rem 0 1rem;
    opacity: 0;
    transform: translateY(15px);
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.15s,
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.15s;
  }

  .deals-slide.active .deals-slide-title {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.dark) .deals-slide-title {
    color: #f8fafc;
  }

  .deals-slide-description {
    font-size: 1.125rem;
    color: #64748b;
    line-height: 1.7;
    max-width: 400px;
    margin-bottom: 1.5rem;
    opacity: 0;
    transform: translateY(15px);
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.2s,
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
  }

  .deals-slide.active .deals-slide-description {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.dark) .deals-slide-description {
    color: #94a3b8;
  }

  .deals-slide-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--queens-primary);
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0;
    transform: translateY(15px);
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.25s,
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.25s,
      gap 0.3s ease;
  }

  .deals-slide.active .deals-slide-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .deals-slide-cta:hover {
    gap: 0.75rem;
  }

  .cta-arrow {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s ease;
  }

  .deals-slide-cta:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* Slide Image - smooth entrance */
  .deals-slide-image-wrapper {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    aspect-ratio: 4/3;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transform: scale(0.95); /* Removed translateX which caused horizontal overflow */
    transition:
      opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1) 0.1s,
      transform 0.7s cubic-bezier(0.4, 0, 0.2, 1) 0.1s;
    will-change: opacity, transform;
  }

  .deals-slide.active .deals-slide-image-wrapper {
    opacity: 1;
    transform: scale(1);
  }

  :global(.dark) .deals-slide-image-wrapper {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
  }

  .deals-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .deals-slide:hover .deals-slide-image {
    transform: scale(1.05);
  }

  /* Controls row: arrows + dots + counter + scroll hint */
  .deals-controls {
    grid-column: 2; /* align with the slides column, not the big number */
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .deals-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(148, 163, 184, 0.5);
    background-color: transparent;
    color: #475569;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.15s ease;
  }

  .deals-nav-btn:hover {
    background-color: var(--queens-primary);
    border-color: var(--queens-primary);
    color: #ffffff;
  }

  .deals-nav-btn:active {
    transform: scale(0.94);
  }

  :global(.dark) .deals-nav-btn {
    color: #cbd5e1;
    border-color: rgba(71, 85, 105, 0.8);
  }

  .deals-nav-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .deals-dots {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .deals-dot {
    width: 0.75rem;
    height: 0.75rem;
    padding: 0;
    border-radius: 9999px;
    border: none;
    background-color: rgba(148, 163, 184, 0.55);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      width 0.25s ease,
      height 0.25s ease;
  }

  .deals-dot:hover {
    background-color: rgba(100, 116, 139, 0.8);
  }

  .deals-dot.active {
    width: 2rem;
    height: 0.75rem;
    background-color: var(--queens-primary);
  }

  .deals-counter {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748b;
    white-space: nowrap;
  }

  :global(.dark) .deals-counter {
    color: #94a3b8;
  }

  /* Scroll hint pill - dismisses after first scroll interaction */
  .deals-scroll-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--queens-primary);
    opacity: 1;
    transition: opacity 0.4s ease;
  }

  .deals-scroll-hint svg {
    width: 1rem;
    height: 1rem;
    animation: deals-hint-bounce 1.6s ease-in-out infinite;
  }

  .deals-scroll-hint.is-hidden {
    opacity: 0;
  }

  @keyframes deals-hint-bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 640px) {
    .deals-controls {
      grid-column: 1 / -1; /* single-column grid on mobile */
      gap: 1rem;
    }

    .deals-nav-btn {
      width: 2.5rem;
      height: 2.5rem;
    }

    .deals-scroll-hint {
      display: none; /* tight space on mobile; dots + counter carry the signal */
    }
  }

  :focus-visible {
    outline: 2px solid var(--queens-primary);
    outline-offset: 3px;
  }

  /* Reduced-motion / static fallback: all offers stacked, no pin */
  .deals-static .deals-slides-track {
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .deals-static .deals-slide {
    position: static;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .deals-static .deals-slide-eyebrow,
  .deals-static .deals-slide-title,
  .deals-static .deals-slide-description,
  .deals-static .deals-slide-cta,
  .deals-static .deals-slide-image-wrapper {
    opacity: 1;
    transform: none;
  }

  .deals-static .deals-controls,
  .deals-static .deals-progress-bar {
    display: none;
  }

  .deals-static .deals-number-column {
    display: none;
  }

  .deals-static .deals-container {
    min-height: 0;
  }

  .deals-static .deals-pin-wrapper {
    min-height: 0;
    padding: 4rem 0;
  }

  /* Screen-reader only helper */
  .deals-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let dealsCtx: any = null;
  let currentSlideIndex = 0;

  function initDealsSlider() {
    if (dealsCtx) dealsCtx.revert();

    const section = document.querySelector("#homepage-deals") as HTMLElement | null;
    const pinWrapper = document.querySelector(".deals-pin-wrapper") as HTMLElement | null;
    if (!section || !pinWrapper) return;

    const slides = section.querySelectorAll(".deals-slide") as NodeListOf<HTMLElement>;
    const numberEl = document.getElementById("deals-active-number");
    const counterEl = document.getElementById("deals-counter-current");
    const liveRegion = document.getElementById("deals-live-region");
    const dots = section.querySelectorAll<HTMLButtonElement>(".deals-dot");
    const prevBtn = document.getElementById("deals-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("deals-next") as HTMLButtonElement | null;
    const scrollHint = document.getElementById("deals-scroll-hint");
    const slideCount = slides.length;

    if (!slides.length) return;

    // Reduced motion: no pin, no scroll-jacking. Show every offer stacked statically.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      section.classList.add("deals-static");
      slides.forEach((slide) => {
        slide.classList.add("active");
        slide.setAttribute("aria-hidden", "false");
        slide.removeAttribute("inert");
      });
      return;
    }
    section.classList.remove("deals-static");

    dealsCtx = gsap.context(() => {
      let dealsST: ScrollTrigger | null = null;

      // Reset current slide index
      currentSlideIndex = 0;

      function applySlideState(newIndex: number) {
        slides.forEach((slide, i) => {
          const isActive = i === newIndex;
          slide.classList.toggle("active", isActive);
          slide.setAttribute("aria-hidden", String(!isActive));
          // Prevent hidden CTAs from stealing keyboard focus
          if (isActive) {
            slide.removeAttribute("inert");
          } else {
            slide.setAttribute("inert", "");
          }
        });

        // Update dots
        dots.forEach((dot, i) => {
          dot.classList.toggle("active", i === newIndex);
          if (i === newIndex) {
            dot.setAttribute("aria-current", "true");
          } else {
            dot.removeAttribute("aria-current");
          }
        });

        // Update big number + counter with a simple fade
        const label = String(newIndex + 1).padStart(2, "0");
        if (numberEl) {
          numberEl.style.transition = "opacity 0.2s ease, transform 0.2s ease";
          numberEl.style.opacity = "0";
          numberEl.style.transform = "translateY(-10px)";

          setTimeout(() => {
            if (numberEl) {
              numberEl.textContent = label;
              numberEl.style.opacity = "1";
              numberEl.style.transform = "translateY(0)";
            }
          }, 200);
        }
        if (counterEl) {
          counterEl.textContent = label;
        }

        // Announce slide change to screen readers
        if (liveRegion) {
          const heading = slides[newIndex].querySelector(".deals-slide-title")?.textContent?.trim();
          liveRegion.textContent = `Offer ${newIndex + 1} of ${slideCount}${heading ? `: ${heading}` : ""}`;
        }

        currentSlideIndex = newIndex;
      }

      // Initialize slides - first is active
      applySlideState(0);

      // Calculate total scroll distance (~65vh per slide, shorter than before so
      // visitors reach every offer without a marathon of pinned scrolling)
      const vhMultiplier = window.innerWidth < 768 ? 0.55 : 0.65;
      const totalScrollHeight = window.innerHeight * vhMultiplier * slideCount;

      function transitionToSlide(newIndex: number) {
        if (newIndex === currentSlideIndex || newIndex < 0 || newIndex >= slideCount) return;
        applySlideState(newIndex);
      }

      // Get progress bar element
      const progressFill = document.getElementById("deals-progress-fill");

      // Set up the pinned scroll
      dealsST = ScrollTrigger.create({
        trigger: section,
        start: "top top",
        end: `+=${totalScrollHeight}`,
        pin: pinWrapper,
        scrub: 0.8,
        onUpdate: (self) => {
          const progress = self.progress;
          const targetIndex = Math.min(
            Math.floor(progress * slideCount),
            slideCount - 1
          );

          if (targetIndex !== currentSlideIndex) {
            transitionToSlide(targetIndex);
          }

          // Update progress bar fill (0% to 100%)
          if (progressFill) {
            progressFill.style.height = `${progress * 100}%`;
          }

          // Dismiss the scroll hint once the visitor starts moving through offers
          if (scrollHint && progress > 0.08) {
            scrollHint.classList.add("is-hidden");
          } else if (scrollHint && progress <= 0.02) {
            scrollHint.classList.remove("is-hidden");
          }

          // Calculate progress within the current slide's "zone" (0 to 1)
          const slideZoneSize = 1 / slideCount;
          const slideZoneStart = targetIndex * slideZoneSize;
          const slideProgress = (progress - slideZoneStart) / slideZoneSize;

          // Clamp to 0-1 range
          const clampedProgress = Math.max(0, Math.min(1, slideProgress));

          // Apply subtle shrink effect to the active slide (scale from 1 to 0.92)
          // This gives visual feedback that scrolling is doing something
          const activeSlide = slides[targetIndex];
          if (activeSlide) {
            const scaleValue = 1 - (clampedProgress * 0.08); // shrinks to 0.92 max
            const opacityValue = 1 - (clampedProgress * 0.15); // fades slightly to 0.85
            activeSlide.style.transform = `scale(${scaleValue})`;
            activeSlide.style.opacity = String(opacityValue);
          }

          // Reset transform on other slides
          slides.forEach((slide, i) => {
            if (i !== targetIndex) {
              slide.style.transform = '';
              slide.style.opacity = '';
            }
          });
        }
      });

      // Controls: clicking a dot/arrow scrolls to the matching point inside the
      // pinned range. Scroll stays the source of truth - controls are affordances.
      function scrollToSlide(index: number) {
        if (!dealsST) return;
        const clamped = Math.max(0, Math.min(slideCount - 1, index));
        const zoneCenter = (clamped + 0.5) / slideCount;
        const targetY = dealsST.start + (dealsST.end - dealsST.start) * zoneCenter;
        const lenis = (window as any).lenis;
        if (lenis?.scrollTo) {
          lenis.scrollTo(targetY, { duration: 0.8 });
        } else {
          window.scrollTo({ top: targetY, behavior: "smooth" });
        }
      }

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const index = Number(dot.dataset.dotIndex);
          if (!Number.isNaN(index)) scrollToSlide(index);
        });
      });

      prevBtn?.addEventListener("click", () => scrollToSlide(currentSlideIndex - 1));
      nextBtn?.addEventListener("click", () => scrollToSlide(currentSlideIndex + 1));
    });
  }

  document.addEventListener("astro:page-load", () => {
    setTimeout(initDealsSlider, 300);
  });

  document.addEventListener("astro:before-swap", () => {
    if (dealsCtx) dealsCtx.revert();
  });
</script>
