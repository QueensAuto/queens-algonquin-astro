{
  "version": 1,
  "description": "Run the Pages Function (markdown negotiation in functions/_middleware.ts) for pages only; static assets and the old paths in _redirects are served directly.",
  "include": [
    "/*"
  ],
  "exclude": [
    "/_astro/*",
    "/images/*",
    "/video/*",
    "/fonts/*",
    "/assets/*",
    "/audio/*",
    "/favicon.png",
    "/favicon.svg",
    "/robots.txt",
    "/llms.txt",
    "/sitemap-index.xml",
    "/sitemap.xml",
    "/reviews",
    "/reviews/",
    "/brake-shop-algonquin*",
    "/tire-shop-algonquin*",
    "/oil-change-service-algonquin*",
    "/mechanic-algonquin*",
    "/auto-air-conditioning-service-algonquin*"
  ]
}
